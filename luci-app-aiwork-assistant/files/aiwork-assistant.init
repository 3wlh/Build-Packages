#!/bin/sh /etc/rc.common

START=99
STOP=10

NAME="aiwork-assistant"
PROG="$(find /usr/sbin/ -maxdepth 1 -name "${NAME}*" | head -1)"

writelog() {
	# echo "$(date "+%Y.%m.%d_%H%M%S") - ${1}" >>/tmp/$NAME.log
	logger -t ${NAME} "${1}"
}

start() {
	config_load "$NAME"
	local enabled
	config_get_bool enabled "config" "enabled" "0"
	[ "$enabled" -eq "1" ] || return 1
	local web_path="/etc/${NAME}/web-dist"
	local port data_path token
	config_get port "config" "port" "7864"
	config_get token "config" "token"
	config_get data_path "config" "data_path" "/etc/${NAME}/data"
	# 创建配置目录
	[ -d ${data_path} ] || mkdir -pm 755 "${data_path}"
	# 构建运行参数
	export AIWORK_WEB_DIST="$web_path"
	export AIWORK_LISTEN_ADDR="0.0.0.0:$port"
	export AIWORK_DATA_DIR="${data_path}"
	[ -n "${token}" ] && export AIWORK_ADMIN_TOKEN="$token"
	# 构建启动参数
	start-stop-daemon -S -q -b -x "$PROG"
	writelog "${NAME} Starting ..."
}

stop() {
	# kill -9 $(pgrep -f "${PROG}*" | sed "s/$$//g") 2>/dev/null
	start-stop-daemon -K -q -s KILL -x "$PROG" 2>/dev/null
	writelog "${NAME} stopped ..."
}