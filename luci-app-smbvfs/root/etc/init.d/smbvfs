#!/bin/sh /etc/rc.common
# luci-app-smbvfs - smbvfsd 用 inotify 监听 /etc/config/samba4 变动,
# 任何方式 (uci commit / LuCI / vi / 直接写文件) 修改后自动补写 fruit 选项
START=99
STOP=10
USE_PROCD=1

start_service() {
	/usr/share/smbvfs/apply.sh
	procd_open_instance smbvfs
	procd_set_param command /usr/sbin/smbvfsd
	procd_set_param respawn
	procd_close_instance
}
